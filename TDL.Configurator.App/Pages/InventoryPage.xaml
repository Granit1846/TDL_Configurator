<UserControl x:Class="TDL.Configurator.App.Pages.InventoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="NumericBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style x:Key="ResetButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Content" Value="↺"/>
        </Style>

        <Style x:Key="RowLabelStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <TextBlock Text="{DynamicResource STR_Inventory_Title}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="{DynamicResource STR_Inventory_Subtitle}"
                       Style="{StaticResource PageSubtitleStyle}"/>

            <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                <Button Content="{DynamicResource STR_Common_SaveApply}" Width="170" Height="22" Margin="0,0,8,0" Click="SaveApply_Click"/>
                <Button Content="{DynamicResource STR_Common_ResetAll}" Width="130" Margin="0,0,12,0" Click="DefaultsAll_Click"/>
                <TextBlock x:Name="InventoryStatusText" Opacity="0.7" VerticalAlignment="Center"/>
            </WrapPanel>

            <GroupBox Header="{DynamicResource STR_Common_Parameters}">
                <StackPanel Margin="10">

                    <Expander Header="{DynamicResource STR_Inventory_Scatter_Group}" IsExpanded="True" Margin="0,0,0,12">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource RowLabelStyle}"
                                       Text="{DynamicResource STR_Inventory_ScatterExactCount_Label}"
                                       ToolTip="{DynamicResource STR_Inventory_ScatterExactCount_TT}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ScatterExactCountBox"
                                     Style="{StaticResource NumericBoxStyle}"/>
                            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource ResetButtonStyle}"
                                    Tag="ScatterExactCount" ToolTip="{DynamicResource STR_Inventory_Reset_ScatterExactCount}" Click="DefaultRow_Click"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource RowLabelStyle}"
                                       Text="{DynamicResource STR_Inventory_ScatterMinCount_Label}"
                                       ToolTip="{DynamicResource STR_Inventory_ScatterMinCount_TT}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ScatterMinCountBox"
                                     Style="{StaticResource NumericBoxStyle}"/>
                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ResetButtonStyle}"
                                    Tag="ScatterMinCount" ToolTip="{DynamicResource STR_Inventory_Reset_ScatterMinCount}" Click="DefaultRow_Click"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource RowLabelStyle}"
                                       Text="{DynamicResource STR_Inventory_ScatterMaxCount_Label}">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="420">
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{DynamicResource STR_Inventory_ScatterMaxCount_TT_Prefix}"/>
                                            <Run Text="{DynamicResource STR_Common_Warning}" Foreground="Red" FontWeight="Bold"/>
                                            <Run Text="{DynamicResource STR_Inventory_ScatterMaxCount_TT_Warn}" Foreground="Red"/>
                                        </TextBlock>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ScatterMaxCountBox"
                                     Style="{StaticResource NumericBoxStyle}"/>
                            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource ResetButtonStyle}"
                                    Tag="ScatterMaxCount" ToolTip="{DynamicResource STR_Inventory_Reset_ScatterMaxCount}" Click="DefaultRow_Click"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource RowLabelStyle}"
                                       Text="{DynamicResource STR_Inventory_ScatterRadius_Label}"
                                       ToolTip="{DynamicResource STR_Inventory_ScatterRadius_TT}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="ScatterRadiusBox"
                                     Style="{StaticResource NumericBoxStyle}"/>
                            <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource ResetButtonStyle}"
                                    Tag="ScatterRadius" ToolTip="{DynamicResource STR_Inventory_Reset_ScatterRadius}" Click="DefaultRow_Click"/>
                        </Grid>
                    </Expander>

                    <Expander Header="{DynamicResource STR_Inventory_Drop_Group}" IsExpanded="True">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource RowLabelStyle}"
                                       Text="{DynamicResource STR_Inventory_DropBatchSize_Label}"
                                       ToolTip="{DynamicResource STR_Inventory_DropBatchSize_TT}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="DropBatchSizeBox"
                                     Style="{StaticResource NumericBoxStyle}"/>
                            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource ResetButtonStyle}"
                                    Tag="DropBatchSize" ToolTip="{DynamicResource STR_Inventory_Reset_DropBatchSize}" Click="DefaultRow_Click"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource RowLabelStyle}"
                                       Text="{DynamicResource STR_Inventory_DropInterval_Label}">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="420">
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{DynamicResource STR_Inventory_DropInterval_TT_Prefix}"/>
                                            <Run Text="{DynamicResource STR_Common_Warning}" Foreground="Red" FontWeight="Bold"/>
                                            <Run Text="{DynamicResource STR_Inventory_DropInterval_TT_Warn}" Foreground="Red"/>
                                        </TextBlock>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="DropIntervalBox"
                                     Style="{StaticResource NumericBoxStyle}"/>
                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ResetButtonStyle}"
                                    Tag="DropInterval" ToolTip="{DynamicResource STR_Inventory_Reset_DropInterval}" Click="DefaultRow_Click"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource RowLabelStyle}"
                                       Text="{DynamicResource STR_Inventory_DropTimeout_Label}"
                                       ToolTip="{DynamicResource STR_Inventory_DropTimeout_TT}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="DropTimeoutBox"
                                     Style="{StaticResource NumericBoxStyle}"/>
                            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource ResetButtonStyle}"
                                    Tag="DropTimeout" ToolTip="{DynamicResource STR_Inventory_Reset_DropTimeout}" Click="DefaultRow_Click"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource RowLabelStyle}"
                                       Text="{DynamicResource STR_Inventory_ProtectTokens_Label}"
                                       ToolTip="{DynamicResource STR_Inventory_ProtectTokens_TT}"/>
                            <CheckBox Grid.Row="3" Grid.Column="1" x:Name="ProtectTokensByNameCheck"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource ResetButtonStyle}"
                                    Tag="ProtectTokensByName" ToolTip="{DynamicResource STR_Inventory_Reset_ProtectTokens}" Click="DefaultRow_Click"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource RowLabelStyle}"
                                       Text="{DynamicResource STR_Inventory_DropShowProgress_Label}"
                                       ToolTip="{DynamicResource STR_Inventory_DropShowProgress_TT}"/>
                            <CheckBox Grid.Row="4" Grid.Column="1" x:Name="DropShowProgressCheck"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource ResetButtonStyle}"
                                    Tag="DropShowProgress" ToolTip="{DynamicResource STR_Inventory_Reset_DropShowProgress}" Click="DefaultRow_Click"/>
                        </Grid>
                    </Expander>

                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
