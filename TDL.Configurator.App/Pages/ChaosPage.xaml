<UserControl x:Class="TDL.Configurator.App.Pages.ChaosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Единый стиль для numeric textbox: центр по горизонтали и вертикали -->
        <Style x:Key="NumericBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <TextBlock Text="{DynamicResource STR_Chaos_Title}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource STR_Chaos_Subtitle}"
                       Opacity="0.7" Margin="0,6,0,16"/>

            <!-- Верхние кнопки -->
            <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                <Button Content="{DynamicResource STR_Common_SaveApply}" Width="170" Height="22" Margin="0,0,8,0" Click="SaveApply_Click"/>
                <Button Content="{DynamicResource STR_Common_ResetAll}" Width="130" Margin="0,0,12,0" Click="DefaultsAll_Click"/>
                <TextBlock x:Name="StatusText" Opacity="0.7" VerticalAlignment="Center"/>
            </WrapPanel>

            <GroupBox Header="{DynamicResource STR_Common_Parameters}">
                <Grid Margin="10">

                    <!-- 0: Название, 1: поле, 2: кнопка default -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- BackfireChance -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{DynamicResource STR_Chaos_BackfireChance_Label}"
                               VerticalAlignment="Center"
                               ToolTip="{DynamicResource STR_Chaos_BackfireChance_Tip}"/>
                    <TextBox x:Name="BackfireChanceBox"
                             Grid.Row="0" Grid.Column="1"
                             Style="{StaticResource NumericBoxStyle}"/>
                    <Button Grid.Row="0" Grid.Column="2"
                            Width="28" Height="26"
                            Content="↺"
                            Tag="BackfireChance"
                            ToolTip="{DynamicResource STR_Chaos_Reset_BackfireChance}"
                            Click="DefaultRow_Click"/>

                    <!-- BackfireDuration -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{DynamicResource STR_Chaos_BackfireDuration_Label}"
                               VerticalAlignment="Center"
                               ToolTip="{DynamicResource STR_Chaos_BackfireDuration_Tip}"/>
                    <TextBox x:Name="BackfireDurationBox"
                             Grid.Row="1" Grid.Column="1"
                             Style="{StaticResource NumericBoxStyle}"/>
                    <Button Grid.Row="1" Grid.Column="2"
                            Width="28" Height="26"
                            Content="↺"
                            Tag="BackfireDuration"
                            ToolTip="{DynamicResource STR_Chaos_Reset_BackfireDuration}"
                            Click="DefaultRow_Click"/>

                    <!-- ShoutPushForce -->
                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="{DynamicResource STR_Chaos_ShoutPushForce_Label}"
                               VerticalAlignment="Center">
                        <TextBlock.ToolTip>
                            <ToolTip MaxWidth="520">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{DynamicResource STR_Chaos_ShoutPushForce_Tip1}"/>
                                    <Run Text="{DynamicResource STR_Common_Warning}" Foreground="Red" FontWeight="Bold"/>
                                    <Run Text="{DynamicResource STR_Chaos_ShoutPushForce_Tip2}"
                                         Foreground="Red"/>
                                </TextBlock>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>

                    <TextBox x:Name="ShoutPushForceBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Style="{StaticResource NumericBoxStyle}"/>

                    <Button Grid.Row="2"
                            Grid.Column="2"
                            Width="28"
                            Height="26"
                            Content="↺"
                            Tag="ShoutPushForce"
                            ToolTip="{DynamicResource STR_Chaos_Reset_BackfireChance}"
                            Click="DefaultRow_Click"/>

                    <!-- ShoutPushDelay -->
                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Text="{DynamicResource STR_Chaos_ShoutPushDelay_Label}"
                               VerticalAlignment="Center"
                               ToolTip="{DynamicResource STR_Chaos_ShoutPushDelay_Tip}"/>
                    <TextBox x:Name="ShoutPushDelayBox"
                             Grid.Row="3" Grid.Column="1"
                             Style="{StaticResource NumericBoxStyle}"/>
                    <Button Grid.Row="3" Grid.Column="2"
                            Width="28" Height="26"
                            Content="↺"
                            Tag="ShoutPushDelay"
                            ToolTip="{DynamicResource STR_Chaos_Reset_ShoutPushDelay}"
                            Click="DefaultRow_Click"/>

                    <!-- KnockbackForce -->
                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="{DynamicResource STR_Chaos_KnockbackForce_Label}"
                               VerticalAlignment="Center">
                        <TextBlock.ToolTip>
                            <ToolTip MaxWidth="520">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{DynamicResource STR_Chaos_KnockbackForce_Tip1}"/>
                                    <Run Text="{DynamicResource STR_Common_Warning}" Foreground="Red" FontWeight="Bold"/>
                                    <Run Text="{DynamicResource STR_Chaos_KnockbackForce_Tip2}"
                                         Foreground="Red"/>
                                </TextBlock>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBox x:Name="KnockbackForceBox"
                             Grid.Row="4" Grid.Column="1"
                             Style="{StaticResource NumericBoxStyle}"/>
                    <Button Grid.Row="4" Grid.Column="2"
                            Width="28" Height="26"
                            Content="↺"
                            Tag="KnockbackForce"
                            ToolTip="{DynamicResource STR_Chaos_Reset_KnockbackForce}"
                            Click="DefaultRow_Click"/>

                    <!-- KnockbackCooldown -->
                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               Text="{DynamicResource STR_Chaos_KnockbackCooldown_Label}"
                               VerticalAlignment="Center">
                        <TextBlock.ToolTip>
                            <ToolTip MaxWidth="520">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{DynamicResource STR_Chaos_KnockbackCooldown_Tip1}"/>
                                    <Run Text="{DynamicResource STR_Common_Warning}" Foreground="Red" FontWeight="Bold"/>
                                    <Run Text="{DynamicResource STR_Chaos_KnockbackCooldown_Tip2}"
                                         Foreground="Red"/>
                                </TextBlock>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBox x:Name="KnockbackCooldownBox"
                             Grid.Row="6" Grid.Column="1"
                             Style="{StaticResource NumericBoxStyle}"/>
                    <Button Grid.Row="6" Grid.Column="2"
                            Width="28" Height="26"
                            Content="↺"
                            Tag="KnockbackCooldown"
                            ToolTip="{DynamicResource STR_Chaos_Reset_KnockbackCooldown}"
                            Click="DefaultRow_Click"/>

                    <!-- KnockbackRadius -->
                    <TextBlock Grid.Row="5" Grid.Column="0"
                               Text="{DynamicResource STR_Chaos_KnockbackRadius_Label}"
                               VerticalAlignment="Center"
                               ToolTip="{DynamicResource STR_Chaos_KnockbackRadius_Tip}"/>
                    <TextBox x:Name="KnockbackRadiusBox"
                             Grid.Row="5" Grid.Column="1"
                             Style="{StaticResource NumericBoxStyle}"/>
                    <Button Grid.Row="5" Grid.Column="2"
                            Width="28" Height="26"
                            Content="↺"
                            Tag="KnockbackRadius"
                            ToolTip="{DynamicResource STR_Chaos_Reset_KnockbackRadius}"
                            Click="DefaultRow_Click"/>

                    <!-- KnockbackMeleeDelay -->
                    <TextBlock Grid.Row="7"
                               Grid.Column="0"
                               Text="{DynamicResource STR_Chaos_KnockbackMeleeDelay_Label}"
                               VerticalAlignment="Center">
                        <TextBlock.ToolTip>
                            <ToolTip MaxWidth="520">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{DynamicResource STR_Chaos_KnockbackMeleeDelay_Tip1}"/>
                                    <Run Text="{DynamicResource STR_Common_Warning}" Foreground="Red" FontWeight="Bold"/>
                                    <Run Text="{DynamicResource STR_Chaos_KnockbackCooldown_Tip2}"
                                         Foreground="Red"/>
                                </TextBlock>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBox x:Name="KnockbackMeleeDelayBox"
                             Grid.Row="7" Grid.Column="1"
                             Style="{StaticResource NumericBoxStyle}"/>
                    <Button Grid.Row="7" Grid.Column="2"
                            Width="28" Height="26"
                            Content="↺"
                            Tag="KnockbackMeleeDelay"
                            ToolTip="{DynamicResource STR_Chaos_Reset_KnockbackMeleeDelay}"
                            Click="DefaultRow_Click"/>

                    <!-- KnockbackBowDelay -->
                    <TextBlock Grid.Row="8"
                               Grid.Column="0"
                               Text="{DynamicResource STR_Chaos_KnockbackBowDelay_Label}"
                               VerticalAlignment="Center">
                        <TextBlock.ToolTip>
                            <ToolTip MaxWidth="520">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{DynamicResource STR_Chaos_KnockbackBowDelay_Tip1}"/>
                                    <Run Text="{DynamicResource STR_Common_Warning}" Foreground="Red" FontWeight="Bold"/>
                                    <Run Text="{DynamicResource STR_Chaos_KnockbackCooldown_Tip2}"
                                         Foreground="Red"/>
                                </TextBlock>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBox x:Name="KnockbackBowDelayBox"
                             Grid.Row="8" Grid.Column="1"
                             Style="{StaticResource NumericBoxStyle}"/>
                    <Button Grid.Row="8" Grid.Column="2"
                            Width="28" Height="26"
                            Content="↺"
                            Tag="KnockbackBowDelay"
                            ToolTip="{DynamicResource STR_Chaos_Reset_KnockbackBowDelay}"
                            Click="DefaultRow_Click"/>

                </Grid>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
