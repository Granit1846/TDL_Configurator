<UserControl x:Class="TDL.Configurator.App.Pages.HunterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <TextBlock Text="{DynamicResource STR_Hunter_Title}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource STR_Hunter_Subtitle}"
                       Opacity="0.7" Margin="0,6,0,16"/>

            <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                <Button Content="{DynamicResource STR_Common_SaveApply}" Width="170" Height="22" Margin="0,0,8,0" Click="SaveApply_Click"/>
                <Button Content="{DynamicResource STR_Common_ResetAll}" Width="130" Margin="0,0,12,0" Click="DefaultsAll_Click"/>
                <TextBlock x:Name="HunterStatusText" Opacity="0.7" VerticalAlignment="Center"/>
            </WrapPanel>

            <GroupBox Header="{DynamicResource STR_Common_Parameters}">
                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- CorpseTime -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource RowLabelStyle}"
                               Text="{DynamicResource STR_Hunter_CorpseTime_Label}"
                               ToolTip="{DynamicResource STR_Hunter_CorpseTime_Tooltip}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="CorpseTimeBox"
                             Style="{StaticResource NumericBoxStyle}"/>
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource ResetButtonStyle}"
                            Tag="CorpseTime" ToolTip="{DynamicResource STR_Hunter_CorpseTime_Reset}" Click="DefaultRow_Click"/>

                    <!-- Duration -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource RowLabelStyle}"
                               Text="{DynamicResource STR_Hunter_Duration_Label}"
                               ToolTip="{DynamicResource STR_Hunter_Duration_Tooltip}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="DurationBox"
                             Style="{StaticResource NumericBoxStyle}"/>
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ResetButtonStyle}"
                            Tag="Duration" ToolTip="{DynamicResource STR_Hunter_Duration_Reset}" Click="DefaultRow_Click"/>

                    <!-- MaxDistance -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource RowLabelStyle}"
                               Text="{DynamicResource STR_Hunter_MaxDistance_Label}"
                               ToolTip="{DynamicResource STR_Hunter_MaxDistance_Tooltip}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="MaxDistanceBox"
                             Style="{StaticResource NumericBoxStyle}"/>
                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource ResetButtonStyle}"
                            Tag="MaxDistance" ToolTip="{DynamicResource STR_Hunter_MaxDistance_Reset}" Click="DefaultRow_Click"/>

                    <!-- ReAggro -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource RowLabelStyle}"
                               Text="{DynamicResource STR_Hunter_ReAggro_Label}"
                               ToolTip="{DynamicResource STR_Hunter_ReAggro_Tooltip}"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="ReAggroBox"
                             Style="{StaticResource NumericBoxStyle}"/>
                    <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource ResetButtonStyle}"
                            Tag="ReAggro" ToolTip="{DynamicResource STR_Hunter_ReAggro_Reset}" Click="DefaultRow_Click"/>

                    <!-- SpawnOffset -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource RowLabelStyle}"
                               Text="{DynamicResource STR_Hunter_SpawnOffset_Label}">
                        <TextBlock.ToolTip>
                            <ToolTip MaxWidth="520">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{DynamicResource STR_Hunter_SpawnOffset_Tooltip_P1}"/>
                                    <Run Text="{DynamicResource STR_Common_Warning}" Foreground="Red" FontWeight="Bold"/>
                                    <Run Text="{DynamicResource STR_Hunter_SpawnOffset_Tooltip_P2}" Foreground="Red"/>
                                </TextBlock>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="SpawnOffsetBox"
                             Style="{StaticResource NumericBoxStyle}"/>
                    <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource ResetButtonStyle}"
                            Tag="SpawnOffset" ToolTip="{DynamicResource STR_Hunter_SpawnOffset_Reset}" Click="DefaultRow_Click"/>
                </Grid>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
