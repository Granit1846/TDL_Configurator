<Window
        Icon="pack://application:,,,/Assets/TDL-logo.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="TDL.Configurator.App.MainWindow"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource STR_App_Title}"
        Style="{DynamicResource TDL.WindowStyle}"
        Width="1100" Height="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource TDL.Brush.Border}" BorderThickness="0,0,0,1"
                Background="{DynamicResource TDL.Brush.HeaderBackground}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource STR_App_Title}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource STR_App_Subtitle}" Opacity="0.7" FontSize="12"/>
                </StackPanel>

                <!-- Launch game (SKSE) -->
                <Button Grid.Column="1" Height="36" Width="100" Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource TDL.LaunchGameButtonStyle}"
                        ToolTip="{DynamicResource STR_LaunchGame_Tooltip}"
                        Click="OnLaunchGameClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/logo6.png" Width="24" Height="24" Stretch="Uniform" Margin="2,0,10,0"/>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource STR_LaunchGame_Line1}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource STR_LaunchGame_Line2}" FontSize="12" FontWeight="SemiBold"  Margin="0,-3,0,0" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Width="140" Height="32"
                        VerticalAlignment="Center"
                        Content="{DynamicResource STR_App_Settings}"
                        Click="OnSettingsClick"/>
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource TDL.Brush.Border}" BorderThickness="0,0,1,0"
                    Background="{DynamicResource TDL.Brush.SidebarBackground}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Логотип прямо над вкладками -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource TDL.Brush.Border}" BorderThickness="0,0,0,1" Padding="10">
                        <Image Source="/Assets/logo.png"
                               Height="144"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" Width="144"/>
                    </Border>

                    <!-- Вкладки -->
                    <ListBox Grid.Row="1"
                         x:Name="NavList"
                         Margin="8" FontSize="18"
                         SelectionChanged="NavList_SelectionChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBoxItem Tag="Chaos" Content="{DynamicResource STR_Tab_Chaos}" Height="30"/>
                        <ListBoxItem Tag="Hunter" Content="{DynamicResource STR_Tab_Hunter}" Height="30"/>
                        <ListBoxItem Tag="Inventory" Content="{DynamicResource STR_Tab_Inventory}" Height="30"/>
                        <ListBoxItem Tag="Wrath" Content="{DynamicResource STR_Tab_Wrath}" Height="30"/>
                        <ListBoxItem Tag="Characteristics" Content="{DynamicResource STR_Tab_Characteristics}" Height="30"/>
                        <ListBoxItem Tag="Show" Content="{DynamicResource STR_Tab_Show}" Height="30"/>
                        <ListBoxItem Tag="Information" Content="{DynamicResource STR_Tab_Information}" Height="30"/>
                        <ListBoxItem Tag="QuickAccess" Content="{DynamicResource STR_Tab_QuickAccess}" Height="30"/>
                        <ListBoxItem x:Name="NavTestItem" Tag="Test" Content="{DynamicResource STR_Tab_Test}" Height="30"/>
                    </ListBox>
                </Grid>
            </Border>


            <!-- Content -->
            <Border Grid.Column="1" Padding="16" Background="{DynamicResource TDL.Brush.PanelBackground}">
                <ContentControl x:Name="MainContent"/>
            </Border>
        </Grid>
    </Grid>
</Window>
