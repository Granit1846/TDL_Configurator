<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:sw="clr-namespace:System.Windows;assembly=PresentationFramework">


    <!-- Tooltip defaults (overridden by theme dictionaries) -->
    <SolidColorBrush x:Key="TDL.Brush.TooltipBackground" Color="#FFFDFDFD"/>
    <SolidColorBrush x:Key="TDL.Brush.TooltipText" Color="#FF111111"/>
    <SolidColorBrush x:Key="TDL.Brush.TooltipBorder" Color="#33000000"/>

    <!-- Base window -->
    <!-- Custom title bar for ALL windows -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource TDL.Brush.WindowBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TDL.Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TDL.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>

        <!-- Delite system title bar -->
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="ResizeMode" Value="CanResize"/>

        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="44"
                                ResizeBorderThickness="6"
                                CornerRadius="0"
                                GlassFrameThickness="0"
                                UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Title bar -->
                            <Grid Grid.Row="0"
                                Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Drag region (behind controls) -->
                                <Border Grid.ColumnSpan="3"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Panel.ZIndex="0"/>

                                <!-- Left: icon + title (drag area too) -->
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0"
                                            Panel.ZIndex="1">
                                    <Image Width="16" Height="16"
                                           Source="{TemplateBinding Icon}"
                                           Margin="0,0,8,0"/>
                                    <TextBlock Text="{TemplateBinding Title}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- Right: caption buttons (MUST be excluded from chrome hit test) -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0"
                                            Panel.ZIndex="2"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                                    <!-- Minimize -->
                                    <Button Style="{StaticResource TDL.CaptionButtonMinStyle}"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                            Command="{x:Static sw:SystemCommands.MinimizeWindowCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <Grid Width="12" Height="12">
                                            <Rectangle Width="10"
                                                       Height="1.6"
                                                       RadiusX="0.8"
                                                       RadiusY="0.8"
                                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <!-- Maximize -->
                                    <Button x:Name="BtnMax"
                                            Style="{StaticResource TDL.CaptionButtonStyle}"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                            Command="{x:Static sw:SystemCommands.MaximizeWindowCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <Grid Width="12" Height="12">
                                            <Path Data="M2,2 H10 V10 H2 Z"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.4"
                                                  SnapsToDevicePixels="True"/>
                                        </Grid>
                                    </Button>

                                    <!-- Restore -->
                                    <Button x:Name="BtnRestore"
                                            Style="{StaticResource TDL.CaptionButtonStyle}"
                                            Visibility="Collapsed"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                            Command="{x:Static sw:SystemCommands.RestoreWindowCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <Grid Width="12" Height="12">
                                            <Path Data="M3,4 H9 V10 H3 Z M5,2 H11 V8 H5 Z"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.2"
                                                  SnapsToDevicePixels="True"/>
                                        </Grid>
                                    </Button>

                                    <!-- Close -->
                                    <Button Style="{StaticResource TDL.CaptionButtonCloseStyle}"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                            Command="{x:Static sw:SystemCommands.CloseWindowCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <Grid Width="12" Height="12">
                                            <Path Data="M3,3 L9,9 M9,3 L3,9"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  SnapsToDevicePixels="True"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Content -->
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter/>
                            </AdornerDecorator>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="BtnMax" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="BtnRestore" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="BtnMax" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="BtnRestore" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TDL.Brush.Text}"/>
    </Style>


    <!-- Tooltips: theme-aware (Dark/Nexus were unreadable with default white tooltip) -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource TDL.Brush.TooltipBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TDL.Brush.TooltipText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TDL.Brush.TooltipBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MaxWidth" Value="560"/>
        <Setter Property="Placement" Value="Mouse"/>
        <Setter Property="HorizontalOffset" Value="8"/>
        <Setter Property="VerticalOffset" Value="10"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
                        </Border.Effect>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="12.5"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Controls -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource TDL.Brush.ControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TDL.Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TDL.Brush.ControlBorder}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource TDL.Brush.Accent}"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource TDL.Brush.ControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TDL.Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TDL.Brush.ControlBorder}"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource TDL.Brush.ControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TDL.Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TDL.Brush.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TDL.Brush.ControlBackgroundHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TDL.Brush.ControlBackgroundPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent button (Save) -->
    <Style x:Key="TDL.AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource TDL.Brush.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TDL.Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource TDL.Brush.AccentText}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TDL.Brush.AccentHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TDL.Brush.AccentHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource TDL.Brush.AccentPressed}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TDL.Brush.AccentPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Icon buttons (bottom links) -->
    <Style x:Key="TDL.IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TDL.Brush.TextDim}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TDL.Brush.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TDL.Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TDL.Brush.HoverPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar ListBox -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TDL.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TDL.Brush.Selection}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- GroupBox (Parameters frame) -->
    <!-- GroupBox (Parameters frame) -->
    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{DynamicResource TDL.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TDL.Brush.Text}"/>
        <Setter Property="Padding" Value="12,10,12,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border SnapsToDevicePixels="True"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <ContentPresenter Grid.Row="0"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              Margin="0,0,0,8"
                                              VerticalAlignment="Center"/>

                            <ContentPresenter Grid.Row="1"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Caption buttons (Min/Max/Close) -->
    <!-- Close hover (Windows-like red) -->
    <SolidColorBrush x:Key="TDL.Brush.CaptionCloseHover" Color="#FFE81123"/>
    <SolidColorBrush x:Key="TDL.Brush.CaptionClosePressed" Color="#FFB50D1E"/>

    <!-- Standard caption button -->
    <Style x:Key="TDL.CaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TDL.Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TDL.Brush.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TDL.Brush.ControlBackgroundHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TDL.Brush.ControlBackgroundPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimize: same hover as standard (the icon itself is the underline) -->
    <Style x:Key="TDL.CaptionButtonMinStyle" TargetType="Button" BasedOn="{StaticResource TDL.CaptionButtonStyle}"/>

    <!-- Close: hover red + white X -->
    <Style x:Key="TDL.CaptionButtonCloseStyle" TargetType="Button" BasedOn="{StaticResource TDL.CaptionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TDL.Brush.CaptionCloseHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TDL.Brush.CaptionCloseHover}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TDL.Brush.CaptionClosePressed}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TDL.Brush.CaptionClosePressed}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom title bar window style (used in Dark/Nexus via TDL.WindowStyle) -->
    <Style x:Key="TDL.CustomChromeWindowStyle"
       TargetType="Window"
       BasedOn="{StaticResource {x:Type Window}}">

        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="ResizeMode" Value="CanResize"/>

        <Setter Property="BorderBrush" Value="{DynamicResource TDL.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>

        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="44"
                                ResizeBorderThickness="6"
                                CornerRadius="0"
                                GlassFrameThickness="0"
                                UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Title bar -->
                            <Border Grid.Row="0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: title (drag area) -->
                                    <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                        <Image Width="16" Height="16"
                                           Source="{TemplateBinding Icon}"
                                           Margin="0,0,8,0"/>
                                        <TextBlock Text="{TemplateBinding Title}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <!-- Right: caption buttons -->
                                    <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                                        <!-- Minimize -->
                                        <Button Style="{StaticResource TDL.CaptionButtonMinStyle}"
                                                Command="{x:Static sw:SystemCommands.MinimizeWindowCommand}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                            <Grid Width="12" Height="12">
                                                <Rectangle Width="10"
                                                           Height="1.6"
                                                           RadiusX="0.8"
                                                           RadiusY="0.8"
                                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>

                                        <!-- Maximize -->
                                        <Button x:Name="BtnMax"
                                                Style="{StaticResource TDL.CaptionButtonStyle}"
                                                Command="{x:Static sw:SystemCommands.MaximizeWindowCommand}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                            <Grid Width="12" Height="12">
                                                <Path Data="M2,2 H10 V10 H2 Z"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.4"
                                                      SnapsToDevicePixels="True"/>
                                            </Grid>
                                        </Button>

                                        <!-- Restore -->
                                        <Button x:Name="BtnRestore"
                                                Style="{StaticResource TDL.CaptionButtonStyle}"
                                                Visibility="Collapsed"
                                                Command="{x:Static sw:SystemCommands.RestoreWindowCommand}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                            <Grid Width="12" Height="12">
                                                <Path Data="M3,4 H9 V10 H3 Z M5,2 H11 V8 H5 Z"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.2"
                                                      SnapsToDevicePixels="True"/>
                                            </Grid>
                                        </Button>

                                        <!-- Close -->
                                        <Button Style="{StaticResource TDL.CaptionButtonCloseStyle}"
                                                Command="{x:Static sw:SystemCommands.CloseWindowCommand}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                            <Grid Width="12" Height="12">
                                                <Path Data="M3,3 L9,9 M9,3 L3,9"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      SnapsToDevicePixels="True"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Client area -->
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter/>
                            </AdornerDecorator>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="BtnMax" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="BtnRestore" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="BtnMax" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="BtnRestore" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
