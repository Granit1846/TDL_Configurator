<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <!-- Dark (default) -->
    <SolidColorBrush x:Key="TDL.Brush.WindowBackground" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="TDL.Brush.PanelBackground" Color="#FF252525"/>
    <SolidColorBrush x:Key="TDL.Brush.HeaderBackground" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="TDL.Brush.SidebarBackground" Color="#FF202020"/>

    <!-- Text: softer than pure white -->
    <!-- Requirements: headings #D1D1D1, other text #DEDEDE -->
    <SolidColorBrush x:Key="TDL.Brush.Text" Color="#FFDEDEDE"/>
    <SolidColorBrush x:Key="TDL.Brush.TextDim" Color="#FFB8B8B8"/>

    <!-- Optional header brush (will be wired in later file: App.xaml / header styles) -->
    <SolidColorBrush x:Key="TDL.Brush.TextHeader" Color="#FFD1D1D1"/>

    <!-- Lines / separators: slightly gray (#DEDEDE) instead of white -->
    <!-- Use alpha to keep them subtle -->
    <SolidColorBrush x:Key="TDL.Brush.Border" Color="#33DEDEDE"/>
    <SolidColorBrush x:Key="TDL.Brush.ControlBorder" Color="#55DEDEDE"/>

    <SolidColorBrush x:Key="TDL.Brush.ControlBackground" Color="#FF2B2B2B"/>
    <SolidColorBrush x:Key="TDL.Brush.ControlBackgroundHover" Color="#FF303030"/>
    <SolidColorBrush x:Key="TDL.Brush.ControlBackgroundPressed" Color="#FF363636"/>

    <!-- Documentation page panes -->
    <SolidColorBrush x:Key="TDL.Brush.DocListBackground" Color="#FF252525"/>
    <SolidColorBrush x:Key="TDL.Brush.DocContentBackground" Color="#FF2B2B2B"/>
    <SolidColorBrush x:Key="TDL.Brush.PaneBorder" Color="#55DEDEDE"/>
    <SolidColorBrush x:Key="TDL.Brush.DocCodeBackground" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="TDL.Brush.DocCodeBorder" Color="#55DEDEDE"/>

    <SolidColorBrush x:Key="TDL.Brush.AccentText" Color="#FF0A0A0A"/>

    <SolidColorBrush x:Key="TDL.Brush.Hover" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="TDL.Brush.HoverPressed" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="TDL.Brush.Selection" Color="#224FC1FF"/>

    <!-- Dark: custom title bar (replaces system non-client area) -->
    <Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="ResizeMode" Value="CanResize"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TDL.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>

        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="44"
                                    ResizeBorderThickness="6"
                                    CornerRadius="0"
                                    GlassFrameThickness="0"
                                    UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Title bar -->
                            <Border Grid.Row="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: icon + title -->
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="12,0,0,0"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Image Width="16" Height="16"
                                               Source="{TemplateBinding Icon}"
                                               Margin="0,0,8,0"
                                               shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                                        <TextBlock Text="{TemplateBinding Title}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                                    </StackPanel>

                                    <!-- Right: caption buttons -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="False">

                                        <!-- Minimize -->
                                        <Button x:Name="BtnMin"
                                                Width="36" Height="26" Margin="6,0,0,0"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource TDL.Brush.ControlBorder}"
                                                BorderThickness="1"
                                                Padding="0"
                                                Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                            <Path Data="M2,7 L12,7"
                                                  Stroke="{DynamicResource TDL.Brush.Text}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                        </Button>

                                        <!-- Maximize -->
                                        <Button x:Name="BtnMax"
                                                Width="36" Height="26" Margin="6,0,0,0"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource TDL.Brush.ControlBorder}"
                                                BorderThickness="1"
                                                Padding="0"
                                                Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                            <Path Data="M3,3 L11,3 L11,11 L3,11 Z"
                                                  Stroke="{DynamicResource TDL.Brush.Text}"
                                                  StrokeThickness="1.4"/>
                                        </Button>

                                        <!-- Restore -->
                                        <Button x:Name="BtnRestore"
                                                Width="36" Height="26" Margin="6,0,0,0"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource TDL.Brush.ControlBorder}"
                                                BorderThickness="1"
                                                Padding="0"
                                                Visibility="Collapsed"
                                                Command="{x:Static SystemCommands.RestoreWindowCommand}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                            <Path Data="M4,3 L12,3 L12,11 L4,11 Z M2,5 L10,5 L10,13 L2,13 Z"
                                                  Stroke="{DynamicResource TDL.Brush.Text}"
                                                  StrokeThickness="1.2"/>
                                        </Button>

                                        <!-- Close -->
                                        <Button x:Name="BtnClose"
                                                Width="36" Height="26" Margin="6,0,0,0"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource TDL.Brush.ControlBorder}"
                                                BorderThickness="1"
                                                Padding="0"
                                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                            <Path Data="M3,3 L11,11 M11,3 L3,11"
                                                  Stroke="{DynamicResource TDL.Brush.Text}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Content -->
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter/>
                            </AdornerDecorator>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="BtnMax" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="BtnRestore" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- If window is not resizable (e.g. SettingsWindow has ResizeMode=NoResize) -->
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="BtnMax" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="BtnRestore" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- Hover/Pressed visuals -->
                        <Trigger SourceName="BtnMin" Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnMin" Property="Background" Value="{DynamicResource TDL.Brush.ControlBackgroundHover}"/>
                        </Trigger>
                        <Trigger SourceName="BtnMax" Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnMax" Property="Background" Value="{DynamicResource TDL.Brush.ControlBackgroundHover}"/>
                        </Trigger>
                        <Trigger SourceName="BtnRestore" Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnRestore" Property="Background" Value="{DynamicResource TDL.Brush.ControlBackgroundHover}"/>
                        </Trigger>
                        <Trigger SourceName="BtnClose" Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnClose" Property="Background" Value="{DynamicResource TDL.Brush.ControlBackgroundHover}"/>
                        </Trigger>

                        <Trigger SourceName="BtnMin" Property="IsPressed" Value="True">
                            <Setter TargetName="BtnMin" Property="Background" Value="{DynamicResource TDL.Brush.ControlBackgroundPressed}"/>
                        </Trigger>
                        <Trigger SourceName="BtnMax" Property="IsPressed" Value="True">
                            <Setter TargetName="BtnMax" Property="Background" Value="{DynamicResource TDL.Brush.ControlBackgroundPressed}"/>
                        </Trigger>
                        <Trigger SourceName="BtnRestore" Property="IsPressed" Value="True">
                            <Setter TargetName="BtnRestore" Property="Background" Value="{DynamicResource TDL.Brush.ControlBackgroundPressed}"/>
                        </Trigger>
                        <Trigger SourceName="BtnClose" Property="IsPressed" Value="True">
                            <Setter TargetName="BtnClose" Property="Background" Value="{DynamicResource TDL.Brush.ControlBackgroundPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TDL.WindowStyle"
       TargetType="Window"
       BasedOn="{StaticResource TDL.CustomChromeWindowStyle}"/>

    <!-- Dark theme overrides: make Accent (Save/Apply) button dark gray; Launch button dark gray -->
    <Style x:Key="TDL.AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource TDL.Brush.ControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TDL.Brush.ControlBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource TDL.Brush.Text}"/>
    </Style>

    <Style x:Key="TDL.LaunchGameButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource TDL.Brush.ControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TDL.Brush.ControlBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource TDL.Brush.Text}"/>
    </Style>

</ResourceDictionary>
