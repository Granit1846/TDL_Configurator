<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- General -->
    <sys:String x:Key="STR_App_Title" xmlns:sys="clr-namespace:System;assembly=mscorlib">TDL Configurator</sys:String>
    <sys:String x:Key="STR_App_Subtitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">External settings UI (INI)</sys:String>
    <sys:String x:Key="STR_App_Settings" xmlns:sys="clr-namespace:System;assembly=mscorlib">Settings</sys:String>

    <!-- Main navigation -->
    <sys:String x:Key="STR_Tab_Chaos" xmlns:sys="clr-namespace:System;assembly=mscorlib">Chaos</sys:String>
    <sys:String x:Key="STR_Tab_Hunter" xmlns:sys="clr-namespace:System;assembly=mscorlib">Hunter</sys:String>
    <sys:String x:Key="STR_Tab_Inventory" xmlns:sys="clr-namespace:System;assembly=mscorlib">Inventory</sys:String>
    <sys:String x:Key="STR_Tab_Wrath" xmlns:sys="clr-namespace:System;assembly=mscorlib">Wrath</sys:String>
    <sys:String x:Key="STR_Tab_Characteristics" xmlns:sys="clr-namespace:System;assembly=mscorlib">Characteristics</sys:String>
    <sys:String x:Key="STR_Tab_Show" xmlns:sys="clr-namespace:System;assembly=mscorlib">Show</sys:String>
    <sys:String x:Key="STR_Tab_Information" xmlns:sys="clr-namespace:System;assembly=mscorlib">Information</sys:String>
    <sys:String x:Key="STR_Tab_QuickAccess" xmlns:sys="clr-namespace:System;assembly=mscorlib">Quick access</sys:String>
    <sys:String x:Key="STR_Tab_Test" xmlns:sys="clr-namespace:System;assembly=mscorlib">Test</sys:String>

    <!-- Generic placeholders -->
    <sys:String x:Key="STR_Page_Placeholder" xmlns:sys="clr-namespace:System;assembly=mscorlib">Page: {0}\n(content will be added later)</sys:String>
    <sys:String x:Key="STR_Settings_Title" xmlns:sys="clr-namespace:System;assembly=mscorlib">Settings</sys:String>
    <sys:String x:Key="STR_Settings_PreviewHint" xmlns:sys="clr-namespace:System;assembly=mscorlib">Preview: theme/language apply immediately. Save commits changes.</sys:String>

    <!-- Settings: Paths -->
    <sys:String x:Key="STR_Settings_GamePath_Label" xmlns:sys="clr-namespace:System;assembly=mscorlib">Game folder (Skyrim Special Edition root)</sys:String>
    <sys:String x:Key="STR_Settings_GamePath_Hint" xmlns:sys="clr-namespace:System;assembly=mscorlib">Example: F:\SteamLibrary\steamapps\common\Skyrim Special Edition</sys:String>
    <sys:String x:Key="STR_Settings_Browse" xmlns:sys="clr-namespace:System;assembly=mscorlib">Browse...</sys:String>

    <!-- Settings: Theme -->
    <sys:String x:Key="STR_Settings_Theme_Label" xmlns:sys="clr-namespace:System;assembly=mscorlib">Theme</sys:String>
    <sys:String x:Key="STR_Settings_Theme_Light" xmlns:sys="clr-namespace:System;assembly=mscorlib">Light (default)</sys:String>
    <sys:String x:Key="STR_Settings_Theme_Dark" xmlns:sys="clr-namespace:System;assembly=mscorlib">Dark (default)</sys:String>
    <sys:String x:Key="STR_Settings_Theme_Nexus" xmlns:sys="clr-namespace:System;assembly=mscorlib">Nexus-style</sys:String>

    <!-- Settings: Language -->
    <sys:String x:Key="STR_Settings_Language_Label" xmlns:sys="clr-namespace:System;assembly=mscorlib">Language</sys:String>
    <sys:String x:Key="STR_Settings_Language_Ru" xmlns:sys="clr-namespace:System;assembly=mscorlib">Russian</sys:String>
    <sys:String x:Key="STR_Settings_Language_En" xmlns:sys="clr-namespace:System;assembly=mscorlib">English</sys:String>

    <!-- Settings: Updates -->
    <sys:String x:Key="STR_Settings_Updates_Label" xmlns:sys="clr-namespace:System;assembly=mscorlib">Updates</sys:String>
    <sys:String x:Key="STR_Settings_CheckUpdates" xmlns:sys="clr-namespace:System;assembly=mscorlib">Check for updates</sys:String>
    <sys:String x:Key="STR_Settings_UpdatePlaceholder" xmlns:sys="clr-namespace:System;assembly=mscorlib">(URL not set yet)</sys:String>

    <!-- Buttons -->
    <sys:String x:Key="STR_Settings_Save" xmlns:sys="clr-namespace:System;assembly=mscorlib">Save</sys:String>
    <sys:String x:Key="STR_Settings_Cancel" xmlns:sys="clr-namespace:System;assembly=mscorlib">Cancel</sys:String>

    <!-- Links tooltips -->
    <sys:String x:Key="STR_Link_Nexus" xmlns:sys="clr-namespace:System;assembly=mscorlib">Nexus</sys:String>
    <sys:String x:Key="STR_Link_GitHub" xmlns:sys="clr-namespace:System;assembly=mscorlib">GitHub</sys:String>
    <sys:String x:Key="STR_Link_Donation" xmlns:sys="clr-namespace:System;assembly=mscorlib">Donation</sys:String>
    <sys:String x:Key="STR_Link_Discord" xmlns:sys="clr-namespace:System;assembly=mscorlib">Discord</sys:String>

    <!-- Messages -->
    <sys:String x:Key="STR_Msg_SelectExistingFolder" xmlns:sys="clr-namespace:System;assembly=mscorlib">Please select an existing game folder.</sys:String>
    <sys:String x:Key="STR_Msg_Settings" xmlns:sys="clr-namespace:System;assembly=mscorlib">Settings</sys:String>
    <sys:String x:Key="STR_Msg_LinkNotSet" xmlns:sys="clr-namespace:System;assembly=mscorlib">Link is not set yet.</sys:String>
    <sys:String x:Key="STR_Msg_UpdateUrlNotSet" xmlns:sys="clr-namespace:System;assembly=mscorlib">Update-check URL is not set yet.</sys:String>

    <!-- QuickAccess -->
    <sys:String x:Key="STR_QuickAccess_Title" xmlns:sys="clr-namespace:System;assembly=mscorlib">Quick access</sys:String>
    <sys:String x:Key="STR_QuickAccess_Subtitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">Quick access to game files and logs.</sys:String>

    <sys:String x:Key="STR_QuickAccess_Group_GameMod" xmlns:sys="clr-namespace:System;assembly=mscorlib">Game / mod</sys:String>
    <sys:String x:Key="STR_QuickAccess_Group_Logs" xmlns:sys="clr-namespace:System;assembly=mscorlib">Logs</sys:String>

    <sys:String x:Key="STR_QuickAccess_OpenPluginsFolder" xmlns:sys="clr-namespace:System;assembly=mscorlib">Open Plugins folder</sys:String>
    <sys:String x:Key="STR_QuickAccess_OpenIni" xmlns:sys="clr-namespace:System;assembly=mscorlib">Open INI (TDL_StreamPlugin.ini)</sys:String>
    <sys:String x:Key="STR_QuickAccess_CreateIniTemplate" xmlns:sys="clr-namespace:System;assembly=mscorlib">Create INI (Default)</sys:String>
    <sys:String x:Key="STR_QuickAccess_OpenToolsFolder" xmlns:sys="clr-namespace:System;assembly=mscorlib">Open Tools folder (tdl_send.exe)</sys:String>
    <sys:String x:Key="STR_QuickAccess_OpenTdlDataFolder" xmlns:sys="clr-namespace:System;assembly=mscorlib">Open Data\TDL folder</sys:String>

    <sys:String x:Key="STR_QuickAccess_OpenTdlLog" xmlns:sys="clr-namespace:System;assembly=mscorlib">Open TDL.0.log</sys:String>
    <sys:String x:Key="STR_QuickAccess_OpenTdlLogFolder" xmlns:sys="clr-namespace:System;assembly=mscorlib">Open TDL log folder</sys:String>
    <sys:String x:Key="STR_QuickAccess_OpenSkseDocsFolder" xmlns:sys="clr-namespace:System;assembly=mscorlib">Open SKSE folder (Documents)</sys:String>
    <sys:String x:Key="STR_QuickAccess_OpenPluginLog" xmlns:sys="clr-namespace:System;assembly=mscorlib">Open TDL_StreamPlugin.log (if any)</sys:String>

    <sys:String x:Key="STR_QuickAccess_Status_NotChecked" xmlns:sys="clr-namespace:System;assembly=mscorlib">Status: not checked</sys:String>

    <!-- QuickAccess: messages & formats (used in code-behind) -->
    <sys:String x:Key="STR_QuickAccess_Msg_SetGamePath" xmlns:sys="clr-namespace:System;assembly=mscorlib">Set the game folder in Settings first (Skyrim Special Edition root).</sys:String>
    <sys:String x:Key="STR_QuickAccess_Msg_FolderNotFound_Fmt" xmlns:sys="clr-namespace:System;assembly=mscorlib">Folder not found:\n{0}</sys:String>
    <sys:String x:Key="STR_QuickAccess_Msg_FileNotFound_Fmt" xmlns:sys="clr-namespace:System;assembly=mscorlib">File not found:\n{0}</sys:String>

    <sys:String x:Key="STR_QuickAccess_Status_GamePathMissing" xmlns:sys="clr-namespace:System;assembly=mscorlib">Status: game folder not set (Settings).</sys:String>
    <sys:String x:Key="STR_QuickAccess_Status_Format" xmlns:sys="clr-namespace:System;assembly=mscorlib">Status: INI={0} | TDL.0.log={1} | Tools={2}</sys:String>
    <sys:String x:Key="STR_QuickAccess_Status_OK" xmlns:sys="clr-namespace:System;assembly=mscorlib">OK</sys:String>
    <sys:String x:Key="STR_QuickAccess_Status_Missing" xmlns:sys="clr-namespace:System;assembly=mscorlib">missing</sys:String>

    <sys:String x:Key="STR_QuickAccess_Msg_IniExists" xmlns:sys="clr-namespace:System;assembly=mscorlib">INI already exists.</sys:String>
    <sys:String x:Key="STR_QuickAccess_Msg_IniCreated" xmlns:sys="clr-namespace:System;assembly=mscorlib">INI created.</sys:String>
    <sys:String x:Key="STR_QuickAccess_Msg_IniCreateFailed_Fmt" xmlns:sys="clr-namespace:System;assembly=mscorlib">Failed to create INI:\n{0}</sys:String>
    <!-- QuickAccess: Status line -->
    <sys:String x:Key="STR_QuickAccess_StatusLine_Format" xmlns:sys="clr-namespace:System;assembly=mscorlib">Status: INI={0} | TDL.0.log={1} | Tools={2}</sys:String>

    <!-- Common -->
    <sys:String x:Key="STR_Common_Ok" xmlns:sys="clr-namespace:System;assembly=mscorlib">OK</sys:String>
    <sys:String x:Key="STR_Common_No" xmlns:sys="clr-namespace:System;assembly=mscorlib">No</sys:String>
    <sys:String x:Key="STR_Common_Status" xmlns:sys="clr-namespace:System;assembly=mscorlib">Status</sys:String>

</ResourceDictionary>
